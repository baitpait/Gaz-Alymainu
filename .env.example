APP_NAME="غاز اليمني"
COMPANY_DISPLAY_NAME="Gaz Al-Yamani"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# للإنتاج (مرجع): APP_URL=https://gaz.baitpait.space
# SESSION_DOMAIN=gaz.baitpait.space
# مسار السيرفر: /home/sarfesak/public_html/gaz
# Document root: /home/sarfesak/public_html/gaz/public
# مستودع: https://github.com/baitpait/Gaz-Alymainu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sarfesak_gaz
DB_USERNAME=sarfesak_gaz
DB_PASSWORD=

# بديل محلي (تطوير): أنشئ قاعدة فارغة ثم php artisan migrate
# DB_DATABASE=gaz_alymainu_local
# DB_USERNAME=root
# DB_PASSWORD=

# SQLite (اختياري للتطوير فقط — عطّل سطور MySQL أعلاه وفعّل التالي):
# DB_CONNECTION=sqlite
# # واترك مسار الملف الافتراضي database/database.sqlite

# مسار mysqldump على السيرفر (اختياري — للنسخ الاحتياطي من الواجهة)
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# مجلد النسخ الاحتياطي (اختياري — الافتراضي storage/app/database-backups)
# DATABASE_BACKUP_PATH=

# واتساب الدعم الفني (أزرار الواجهة)
SUPPORT_WHATSAPP=970599814758

# تذييل النظام — رابط المطوّر
DEVELOPER_URL=https://baitpait.com
DEVELOPER_CREDIT="تطوير وبرمجة بيت البرمجيات وتكنولوجيا المعلومات"

# قاعدة البيانات المرجعية القديمة (للقراءة فقط)
DB_LEGACY=database/business_v1.sqlite

# استيراد ERP القديم (php artisan legacy-erp:import) — اتصال منفصل للقراءة فقط
# LEGACY_ERP_DRIVER=mysql
# LEGACY_ERP_HOST=127.0.0.1
# LEGACY_ERP_PORT=3306
# LEGACY_ERP_DATABASE=sarfesak_gazMedia
# LEGACY_ERP_USERNAME=root
# LEGACY_ERP_PASSWORD=
# LEGACY_ERP_FOREIGN_KEYS=false
# للاختبار المحلي بملف SQLite: LEGACY_ERP_DRIVER=sqlite و LEGACY_ERP_DATABASE=المسار الكامل لملف .sqlite
# LEGACY_ERP_DEFAULT_CURRENCY=ILS
# LEGACY_ERP_RECORDED_BY_EMAIL=

# بذور التطوير: مستخدم مدير (php artisan db:seed) — في الإنتاج اضبط SEED_DEV_ADMIN=true فقط إن أردت ذلك صراحةً
# SEED_DEV_ADMIN=false
# DEV_ADMIN_EMAIL=admin@gaz.local
# DEV_ADMIN_PASSWORD=password
# DEV_ADMIN_NAME=مدير النظام

# بيانات تجريبية (عملاء، فواتير، …) — مع SEED_DEV_ADMIN أو بعد وجود مستخدمين
# SEED_DEMO_DATA=false
# أو مباشرة: php artisan db:seed --class=DemoDataSeeder

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# للإنتاج مع APK: اترك SESSION_DOMAIN=null (تجنب 419 في Capacitor WebView)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PDF من قالب الطباعة (Browsershot + Puppeteer) — انظر docs/08_DEPLOYMENT_AND_OPERATIONS_AR.md §11
# BROWSERSHOT_NODE=/usr/bin/node
# BROWSERSHOT_NODE_MODULES=/home/sarfesak/public_html/gaz/node_modules
# PUPPETEER_CACHE_DIR=/home/sarfesak/public_html/gaz/storage/app/puppeteer-cache
# BROWSERSHOT_CHROME_PATH=   # اختياري — يُكتشف تلقائياً من puppeteer
# BROWSERSHOT_NO_SANDBOX=true   # مطلوب على Linux المشترك
# BROWSERSHOT_PDF_DELAY_MS=1500

# Google Maps (Maps JavaScript API) — never commit real keys
# قيّد المفتاح في Google Cloud على: https://gaz.baitpait.space/* و http://127.0.0.1:8001/*
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DEFAULT_LAT=31.9038
GOOGLE_MAPS_DEFAULT_LNG=35.2034

# تطبيق السائق (Capacitor APK — GPS بالخلفية)
DRIVER_APP_URL="${APP_URL}"
DRIVER_LOCATION_PING_SECONDS=30
DRIVER_BG_NOTIFICATION_TITLE="غاز اليمني"
DRIVER_BG_NOTIFICATION_TEXT="مشاركة موقعك نشطة أثناء الوردية"
